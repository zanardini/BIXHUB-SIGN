  "components": {
    "schemas": {
      "CreateSessionRequest": {
        "required": [
          "flowType"
        ],
        "type": "object",
        "properties": {
          "description": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "metadata": {
