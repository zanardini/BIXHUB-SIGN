          },
          "webhooks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IdeWebhookDto"
            },
            "nullable": true
          },
          "flowType": {
            "$ref": "#/components/schemas/SessionFlowTypeDto"
          }
        },
        "additionalProperties": false
      },
      "CreateSessionResponse": {
        "type": "object",
        "properties": {
          "sessionGuid": {
            "type": "string",
            "format": "uuid"
          },
          "sessionUrl": {
            "required": [
              "hostNameType"
            ],
            "type": "string",
            "format": "uri",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DeclaredPersonalData": {
        "required": [
          "phoneNumber",
          "taxCode"
        ],
        "type": "object",
        "properties": {
          "taxCode": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 50,
            "type": "string",
            "format": "email",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DigitalIdentityResponse": {
        "type": "object",
        "properties": {
          "request": {
            "type": "string",
            "nullable": true
          },
          "response": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DocumentType": {
        "enum": [
          "IdentityCard",
          "DrivingLicense",
          "Passport"
        ],
        "type": "string",
        "x-enumNames": [
          "IdentityCard",
          "DrivingLicense",
          "Passport"
        ]
      },
      "ExceptionResult": {
        "type": "object",
        "properties": {
          "errorId": {
            "type": "string",
            "format": "uuid"
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "errorCodeDescription": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FlowStep": {
        "type": "object",
        "properties": {
          "indexOrder": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "verified": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "GetAcquiredIDInfoRequest": {
        "type": "object",
        "properties": {
          "withPersonalData": {
            "type": "boolean",
            "nullable": true
          },
          "withIDCard": {
            "type": "boolean",
            "nullable": true
          },
          "withSelfie": {
            "type": "boolean",
            "nullable": true
          },
          "withLivenessDetection": {
            "type": "boolean",
            "nullable": true
          },
          "withDigitalIdentityReqResp": {
            "type": "boolean",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "GetAcquiredIDInfoResponse": {
        "type": "object",
